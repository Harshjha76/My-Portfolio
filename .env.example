# ==============================================================================
# HARSH JHA — PERSONAL PORTFOLIO WEBSITE ENVIRONMENT CONFIGURATION
# ==============================================================================

# Node Environment
NODE_ENV=production

# Private Owner Authentication Secret
# Used to cryptographically sign session JWT tokens for the private editing area
OWNER_JWT_SECRET=harsh-jha-private-jwt-secret-key-super-secure-2026-prod

# Optional Master Owner Password Override
# Default if unset: harshjha@portfolio2025
OWNER_PASSWORD=harshjha@portfolio2025

# ------------------------------------------------------------------------------
# OPTIONAL: SUPABASE CLOUD DATABASE & STORAGE
# When these variables are omitted, the portfolio automatically operates in
# zero-dependency Local Storage Mode (using ./data/portfolio-db.json and ./public/uploads).
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
