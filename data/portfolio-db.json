    {
      "id": "proj-fintrack",
      "title": "FinTrack — Smart Finance Manager",
      "repoName": "Fintrack_Capstone",
      "githubUrl": "https://github.com/Harshjha76/Fintrack_Capstone",
      "shortDescription": "Personal finance management system designed to organize income, expenses, budgets and savings goals with analytical insights.",
      "fullDescription": "FinTrack is a personal finance management system designed to organize income, expenses, budgets and savings goals. It uses a Flask REST API and MySQL database to manage financial records and provide dashboard summaries and analytical insights.",
      "problemStatement": "Students and young professionals often struggle with tracking variable daily expenses, maintaining realistic monthly savings targets, and understanding their financial patterns through actionable summaries.",
      "solution": "Engineered a structured RESTful backend in Python Flask connected to a normalized MySQL database schema. The system allows logging income and categorized expenditures, calculates monthly running balances, tracks progress toward user-defined savings goals, and generates informative dashboard summaries.",
      "technologies": [
        "Python",
        "Flask",
        "MySQL",
        "REST API",
        "JSON",
        "React (Reference UI)"
      ],
      "mainFeatures": [
        "Income and expense transaction tracking with category breakdown",
        "Configurable monthly budget management",
        "Target-based savings goals tracking",
        "Automated alerts and notification system",
        "Dashboard summaries with aggregated financial metrics",
        "Financial analytics for spending patterns"
      ],
      "screenshots": [],
      "status": "Reference Export",
      "futureImprovements": [
        "Migrate to standalone containerized deployment (Docker)",
        "Add automated recurring transaction scheduling",
        "Export personal financial statements to PDF and CSV"
      ],
      "verifiedNote": "The repository includes a runnable Flask/MySQL backend and a React frontend reference export. The frontend export depends on its original hosting platform and should not be presented as a fully independent working application.",
      "isFeatured": true,
      "isPublished": true
    },
